# Copy to .env.production (ignored), chmod 600; never commit real credentials.
FINORA_DOMAIN=finance.example.com
POSTGRES_PASSWORD=replace-with-long-random-password
# URL-encode password special characters; db is the internal Compose service.
DATABASE_URL=postgresql://finora:replace-with-long-random-password@db:5432/finora
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
