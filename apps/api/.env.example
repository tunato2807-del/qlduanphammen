DATABASE_URL=postgresql://finora:finora_local_dev@localhost:5432/finora?schema=public
PORT=3001
# Set true only if you intentionally want isolated demo accounts in production.
ALLOW_DEMO=false
# Optional email recovery. Local mailbox: docker compose -f compose.mail.yaml up -d

# Start Mailpit first, then uncomment these settings to enable email.
# PUBLIC_URL=http://localhost:5173
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# MAIL_FROM=Finora <noreply@finora.local>
# SMTP_USER=
# SMTP_PASSWORD=
# Production only behind the single trusted Caddy proxy:
# TRUST_PROXY=1
